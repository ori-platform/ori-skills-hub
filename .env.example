# Runtime
HUB_ENV=development
HUB_DATABASE_URL=sqlite:///./.hub-data/skills-hub.db
HUB_STORAGE_BACKEND=local
HUB_STORAGE_LOCAL_DIR=./.hub-data/tarballs

# Security
HUB_ADMIN_API_KEY=replace-with-at-least-32-random-characters
HUB_ADMIN_ACTOR_ID=bootstrap-admin
HUB_AUTHOR_REGISTRATION_ENABLED=false
HUB_AUTHOR_TOKEN_TTL_SECONDS=2592000
HUB_VIRUSTOTAL_API_KEY=

# Publish signing (choose the shared root source OR both profile sources).
# File-backed secrets are preferred. Never place these files in a Git worktree.
# HUB_ROOT_SIGNING_PRIVATE_KEY_FILE=/run/secrets/hub-root-private-key.b64
# HUB_MANIFEST_SIGNING_PRIVATE_KEY_FILE=/run/secrets/hub-manifest-private-key.b64
# HUB_ARTIFACT_SIGNING_PRIVATE_KEY_FILE=/run/secrets/hub-artifact-private-key.b64

# Compatibility
HUB_RUNTIME_BASELINE=v0.9.0-beta.2
HUB_SPECS_BASELINE=v1
